# Copy to .env and adjust as needed. The server reads these from the process
# environment; nothing loads this file automatically, so either export the
# values yourself or start Node with --env-file, for example:
#   node --env-file=.env dist/server/src/index.js

# Port the HTTP server listens on.
PORT=4000

# SQLite database file. The folder is created on first start.
DB_PATH=./data/flowqueue.db

# Seconds a worker may hold a job before another poll takes it over.
# Keep it longer than your slowest handler.
LEASE_SECONDS=60

# Milliseconds between worker polls.
WORKER_POLL_MS=1000

# Most jobs one poll may reserve across all queues.
WORKER_BATCH_SIZE=5
